# Copy to .env for `make run`. docker compose sets its own values.

PORT=8080
DATABASE_URL=postgres://seats:seats@localhost:5432/seats?sslmode=disable

# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# Postgres connections held by the app. Keep below the server's max_connections.
DB_MAX_CONNS=16

# Concurrent write requests admitted before the app answers 429.
ADMISSION_LIMIT=64

# Max seats one user can hold per show.
PER_USER_LIMIT=4

# debug | info | warn | error
LOG_LEVEL=info

# How long in-flight requests get to finish on SIGTERM.
SHUTDOWN_TIMEOUT=20s

# Exposes POST /auth/token so the burst script can mint test tokens.
# Test helper only. Leave false anywhere real users exist.
ENABLE_TOKEN_ENDPOINT=false
